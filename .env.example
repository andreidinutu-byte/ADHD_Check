# Names only. Copy to .env.local (gitignored) and fill the values there. Never commit values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
RESEND_API_KEY=
# Sender of every email (FR-50 and the paid report). An address on a domain verified in Resend. Unset outside production, the Resend test sender is used.
EMAIL_FROM=
# Public address of the site, no trailing slash (Stripe return URLs and email links). Required for checkout and for emails with a link.
SITE_URL=
DEMO_PARENT_EMAIL=
# Local only, for scripts/demo-rehearsal.mts; the app never reads it, so it does not go on the server.
DEMO_PARENT_PASSWORD=
# Set to 1 to serve the dev game pages under /play in production; read at build, off by default.
GAME_HARNESS=
# PocketBase (the database, docs/HOSTING.md). Both URLs are public. PB_URL is the server's address for it (on the
# web server, a private one); NEXT_PUBLIC_PB_URL is the browser's. Ask Andrei for the superuser values.
PB_URL=https://unihub-db.andreidobrin.com
NEXT_PUBLIC_PB_URL=https://unihub-db.andreidobrin.com
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
