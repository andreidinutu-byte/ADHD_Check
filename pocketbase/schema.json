[
  {
    "id": "pbc_children000",
    "name": "children",
    "type": "base",
    "listRule": "parent = @request.auth.id",
    "viewRule": "parent = @request.auth.id",
    "createRule": "@request.auth.id != \"\" && @request.body.parent = @request.auth.id",
    "deleteRule": "parent = @request.auth.id",
    "updateRule": "parent = @request.auth.id && (@request.body.parent:isset = false || @request.body.parent = @request.auth.id)",
    "fields": [
      {
        "name": "id",
        "type": "text",
        "primaryKey": true,
        "required": true,
        "system": true,
        "pattern": "^[0-9a-f-]{36}$",
        "min": 36,
        "max": 36,
        "autogeneratePattern": "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
      },
      {
        "name": "parent",
        "type": "relation",
        "collectionId": "_pb_users_auth_",
        "maxSelect": 1,
        "cascadeDelete": true,
        "required": true
      },
      {
        "name": "nickname",
        "type": "text",
        "required": true,
        "max": 40
      },
      {
        "name": "birth_year",
        "type": "number",
        "required": true,
        "onlyInt": true,
        "min": 2000,
        "max": 2100
      },
      {
        "name": "created_at",
        "type": "autodate",
        "onCreate": true,
        "onUpdate": false
      }
    ],
    "indexes": [
      "CREATE INDEX idx_children_parent ON children (parent)"
    ]
  },
