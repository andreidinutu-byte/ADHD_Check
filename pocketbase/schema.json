  {
    "id": "pbc_missions000",
    "name": "missions",
    "type": "base",
    "listRule": "parent = @request.auth.id",
    "viewRule": "parent = @request.auth.id",
    "deleteRule": "parent = @request.auth.id",
    "createRule": "@request.auth.id != \"\" && @request.body.parent = @request.auth.id && @request.body.child.parent = @request.auth.id && (@request.body.chosen_by:isset = false || @request.body.chosen_by = \"parent\") && @request.body.status = \"todo\" && @request.body.done_at:isset = false",
    "updateRule": "parent = @request.auth.id && @request.body.parent:isset = false && @request.body.child:isset = false && @request.body.chosen_by:isset = false && @request.body.mission_key:isset = false && @request.body.created_at:isset = false",
    "fields": [
      {
        "name": "id",
        "type": "text",
        "primaryKey": true,
        "required": true,
        "system": true,
        "pattern": "^[0-9a-f-]{36}$",
        "min": 36,
        "max": 36,
        "autogeneratePattern": "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
      },
      {
        "name": "child",
        "type": "relation",
        "collectionId": "pbc_children000",
        "maxSelect": 1,
        "cascadeDelete": true,
        "required": true
      },
      {
        "name": "parent",
        "type": "relation",
        "collectionId": "_pb_users_auth_",
        "maxSelect": 1,
        "cascadeDelete": true,
        "required": true
      },
      {
        "name": "mission_key",
        "type": "text",
        "required": true,
        "pattern": "^[a-z0-9_]{1,64}$"
      },
      {
        "name": "chosen_by",
        "type": "select",
        "values": [
          "parent",
          "professional"
        ],
        "maxSelect": 1
      },
      {
        "name": "status",
        "type": "select",
        "values": [
          "todo",
          "done"
        ],
        "maxSelect": 1,
        "required": true
      },
      {
        "name": "created_at",
        "type": "date",
        "required": true
      },
      {
        "name": "done_at",
        "type": "date"
      }
    ],
    "indexes": [
      "CREATE INDEX idx_missions_child ON missions (child, created_at)"
    ]
